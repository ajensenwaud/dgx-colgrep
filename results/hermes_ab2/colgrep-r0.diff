+def _tag_failed_api_key(exc: BaseException, client: Any) -> None:
+    """Record on ``exc`` the API key of the client whose request raised it.
+
+    The post-recovery retry rebuilds its client internally, so the caller
+    that later feeds the error to :func:`_recover_provider_pool` cannot see
+    which key was sent. Without that identity the pool falls back to
+    current()/next-available and benches a healthy key for this failure.
+    """
+    key = str(getattr(client, "api_key", "") or "")
+    if not key:
+        return
+    try:
+        setattr(exc, _FAILED_API_KEY_ATTR, key)
+    except Exception:
+        pass
+
+
+def _failed_api_key_of(exc: BaseException) -> str:
+    return str(getattr(exc, _FAILED_API_KEY_ATTR, "") or "")
+
