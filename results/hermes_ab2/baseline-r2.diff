+def _tag_failed_api_key(exc: Exception, client: Any) -> None:
+    """Record on *exc* the API key the failing request was sent with.
+
+    The post-recovery retry builds its own client, so the caller only sees
+    the exception. Without the key, ``_recover_provider_pool`` loads a fresh
+    pool (``current()`` is None) and the rotation marks whichever entry
+    would be selected next — typically the healthy backup key, not the one
+    that just returned 429.
+    """
+    key = str(getattr(client, "api_key", "") or "")
+    if not key:
+        return
+    try:
+        setattr(exc, "_hermes_failed_api_key", key)
+    except Exception:
+        pass
 
 
