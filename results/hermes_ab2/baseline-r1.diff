+def _reconcile_failed_credential_id(
+    pool, credential_id: Optional[str], api_key_hint: Any,
+) -> Optional[str]:
+    """Return the pool-entry id that actually sent the failing request.
+
+    Keeps ``credential_id`` when it owns ``api_key_hint`` or when the hint
+    matches no entry (an OAuth token refreshed after the request was sent —
+    the reason the id is tracked at all). When the hint matches a different
+    entry, the id is stale and that entry's id is returned instead.
+    """
+    if not credential_id or not api_key_hint:
+        return credential_id
+    try:
+        entries = list(pool.entries())
+    except Exception:
+        return credential_id
+    for entry in entries:
+        if getattr(entry, "id", None) == credential_id:
+            if getattr(entry, "runtime_api_key", None) == api_key_hint:
+                return credential_id
+            break
+    for entry in entries:
+        if getattr(entry, "runtime_api_key", None) == api_key_hint:
+            entry_id = getattr(entry, "id", None)
+            if isinstance(entry_id, str) and entry_id:
+                return entry_id
+    return credential_id
+
