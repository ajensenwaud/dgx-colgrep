+    #: Upper bound on nested JSON-string layers unwrapped by
+    #: :meth:`_decode_json_column` (legacy rows double-encoded once per
+    #: fork round-trip before the encode guard landed).
+    _MAX_JSON_UNWRAP = 8
+
+    @classmethod
+    def _decode_json_column(cls, raw: Any) -> Any:
+        """Decode a structured JSON TEXT column, unwrapping stacked encodings.
+
+        Used for ``reasoning_details`` / ``codex_reasoning_items`` /
+        ``codex_message_items``. Rows written before the encode guard could
+        carry one extra JSON-string layer per get_messages -> replace_messages
+        round-trip, so keep unwrapping while the value is still a string that
+        parses as JSON. Raises ``json.JSONDecodeError`` / ``TypeError`` only
+        when the outermost layer is not JSON.
+        """
+        if not isinstance(raw, str):
+            return raw
+        value: Any = json.loads(raw)
+        for _ in range(cls._MAX_JSON_UNWRAP):
+            if not isinstance(value, str):
+                break
+            try:
+                value = json.loads(value)
+            except (json.JSONDecodeError, TypeError):
+                break
+        return value
+
+    @classmethod
+    def _encode_json_column(cls, value: Any) -> Optional[str]:
+        """Serialize a structured reasoning field for its TEXT column.
+
+        Live callers pass Python lists; fork/branch/import paths pass the
+        already-serialized TEXT straight from :meth:`get_messages`.
+        ``json.dumps`` on that string stores a quoted JSON string, and the
+        single decode on read then yields a ``str`` — which every consumer
+        gates out with ``isinstance(..., list)``, silently dropping preserved
+        thinking blocks and Codex continuation state. Parse strings first.
+        """
+        if isinstance(value, str):
+            try:
+                value = cls._decode_json_column(value)
+            except (json.JSONDecodeError, TypeError):
+                # Not JSON at all: store as a JSON string so nothing is lost.
+                pass
+        if not value:
+            return None
+        try:
+            return json.dumps(value)
+        except (TypeError, ValueError):
+            logger.warning(
+                "Ignoring non-serializable structured reasoning field on write: %s",
+                type(value).__name__,
+            )
+            return None
+
