+def branch_copy_row(msg: Mapping[str, Any]) -> dict:
+    """Build the ``append_messages_batch`` row for copying *msg* into a branch.
+
+    Single source of truth for every /branch / session.branch copy site, so a
+    branch carries the parent's tool-call linkage, reasoning text, preserved
+    thinking blocks (``reasoning_details``) and Codex continuation state
+    (``codex_reasoning_items`` / ``codex_message_items``) — dropping any of
+    them makes the branch replay without context the parent had. Also keeps
+    the ``api_content`` sidecar (warm prompt cache on the branch's first turn)
+    and the original timestamp (branch copies are history, not new activity).
+    """
+    return {
+        "role": msg.get("role", "user"),
+        "content": msg.get("content"),
+        "tool_name": msg.get("tool_name") or msg.get("name"),
+        "tool_calls": msg.get("tool_calls"),
+        "tool_call_id": msg.get("tool_call_id"),
+        "finish_reason": msg.get("finish_reason"),
+        "reasoning": msg.get("reasoning"),
+        "reasoning_content": msg.get("reasoning_content"),
+        "reasoning_details": msg.get("reasoning_details"),
+        "codex_reasoning_items": msg.get("codex_reasoning_items"),
+        "codex_message_items": msg.get("codex_message_items"),
+        "api_content": extract_api_content_sidecar(msg),
+        "timestamp": msg.get("timestamp"),
+    }
+
+
