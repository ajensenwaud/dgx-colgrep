     return _sanitize_surrogates(value) if isinstance(value, str) else value
 
 
+def _encode_json_column(value: Any) -> Optional[str]:
+    """Serialize a structured JSON column (reasoning_details, codex_*_items).
+
+    Callers pass either the live structure (list/dict from the agent) or the
+    column's already-serialized TEXT (a raw ``get_messages`` row forwarded by
+    fork/branch/copy paths). ``json.dumps`` on the latter wraps it in another
+    string layer, so reads hydrate a ``str`` instead of a list and every
+    consumer gating on ``isinstance(..., list)`` silently drops it — once per
+    round-trip. Decode text first so both shapes store identical JSON.
+    Text that is not valid JSON is kept as a JSON string (prior behaviour).
+    """
+    if isinstance(value, str):
+        try:
+            value = json.loads(value)
+        except (json.JSONDecodeError, TypeError, ValueError):
+            pass
+    if not value:
+        return None
+    return json.dumps(value)
+
