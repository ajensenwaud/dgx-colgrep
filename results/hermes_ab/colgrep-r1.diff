+def branch_copy_row(msg: Mapping[str, Any]) -> Dict[str, Any]:
+    """Build the ``append_messages_batch`` row that copies *msg* into a branch.
+
+    Shared by every branch/fork copy site (CLI ``/branch``, gateway
+    ``/branch``, TUI ``session.branch`` and the TUI branch-seed persist) so
+    they cannot drift apart again. A branch must replay exactly like its
+    parent: dropping ``reasoning_details`` / ``codex_*_items`` loses the
+    preserved thinking blocks and Codex encrypted-reasoning continuation
+    state, and dropping ``tool_calls`` / ``tool_call_id`` orphans tool rows.
+    The parent's timestamps are kept — branch copies are history, not new
+    activity.
+    """
+    return {
+        "role": msg.get("role", "user"),
+        "content": msg.get("content"),
+        "tool_name": msg.get("tool_name") or msg.get("name"),
+        "tool_calls": msg.get("tool_calls"),
+        "tool_call_id": msg.get("tool_call_id"),
+        "finish_reason": msg.get("finish_reason"),
+        "reasoning": msg.get("reasoning"),
+        "reasoning_content": msg.get("reasoning_content"),
+        "reasoning_details": msg.get("reasoning_details"),
+        "codex_reasoning_items": msg.get("codex_reasoning_items"),
+        "codex_message_items": msg.get("codex_message_items"),
+        # Keep the api_content sidecar so the branch's first turn replays the
+        # parent's exact wire bytes (warm provider prompt cache).
+        "api_content": extract_api_content_sidecar(msg),
+        "timestamp": msg.get("timestamp"),
+    }
+
+
