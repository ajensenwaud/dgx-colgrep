+    @staticmethod
+    def _encode_json_field(value: Any) -> Optional[str]:
+        """Serialize a structured reasoning column without double-encoding.
+
+        ``reasoning_details`` / ``codex_reasoning_items`` /
+        ``codex_message_items`` arrive as Python lists from the live agent but
+        as already-serialized JSON TEXT from raw ``get_messages`` rows (fork,
+        branch, import/replace paths). ``json.dumps`` on that string stores a
+        quoted JSON string, which the single ``json.loads`` on read hands back
+        as a ``str`` — and every consumer gates on ``isinstance(..., list)``,
+        so the continuation state is silently dropped. Parse strings first.
+        """
+        if not value:
+            return None
+        if isinstance(value, str):
+            try:
+                value = json.loads(value)
+            except (json.JSONDecodeError, TypeError):
+                logger.warning("Ignoring non-JSON structured reasoning field on write")
+                return None
+            # Unwrap a legacy double-encoded layer if present.
+            if isinstance(value, str):
+                try:
+                    value = json.loads(value)
+                except (json.JSONDecodeError, TypeError):
+                    return None
+            if not value:
+                return None
+        return json.dumps(value)
+
+    @staticmethod
+    def _decode_json_field(raw: Any, field: str) -> Any:
+        """Decode a structured reasoning column, unwrapping legacy double-encoding."""
+        try:
+            value = json.loads(raw) if isinstance(raw, str) else raw
+            if isinstance(value, str):
+                value = json.loads(value)
+        except (json.JSONDecodeError, TypeError):
+            logger.warning("Failed to deserialize %s, falling back to None", field)
+            return None
+        return value
+
