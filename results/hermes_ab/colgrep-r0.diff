+    # Bound on how many stacked JSON-string layers the reader peels off a
+    # structured column (legacy rows were re-encoded once per fork round-trip).
+    _JSON_FIELD_MAX_LAYERS = 8
+
+    @staticmethod
+    def _encode_json_field(value: Any) -> Optional[str]:
+        """Serialize a structured column (reasoning_details, codex_*_items).
+
+        Accepts the live structure (list/dict) OR the stored TEXT form a raw
+        ``get_messages`` row carries. ``json.dumps`` on the latter would wrap
+        the already-serialized string in another JSON layer, so every
+        ``get_messages -> replace_messages`` fork (and every row-copy via
+        ``append_message``) added one encoding layer and the reader got a
+        ``str`` back instead of a list. Strings are parsed first, mirroring
+        the ``tool_calls`` handling. Empty values persist as NULL.
+        """
+        if isinstance(value, (bytes, bytearray)):
+            value = value.decode("utf-8", errors="replace")
+        if isinstance(value, str):
+            try:
+                value = json.loads(value)
+            except (json.JSONDecodeError, TypeError):
+                logger.debug("Dropping non-JSON structured field value")
+                return None
+        if not value:
+            return None
+        try:
+            return json.dumps(value)
+        except (TypeError, ValueError):
+            logger.warning("Failed to serialize structured field, storing NULL")
+            return None
+
+    @classmethod
+    def _decode_json_field(cls, raw: Any) -> Any:
+        """Reverse :meth:`_encode_json_field`.
+
+        Also heals rows written before the encoder stopped double-encoding:
+        a value that decodes to a JSON string is decoded again (bounded).
+        Raises ``json.JSONDecodeError``/``TypeError`` on undecodable input.
+        """
+        value = json.loads(raw)
+        for _ in range(cls._JSON_FIELD_MAX_LAYERS):
+            if not isinstance(value, str):
+                break
+            try:
+                value = json.loads(value)
+            except (json.JSONDecodeError, TypeError):
+                break
+        return value
+
