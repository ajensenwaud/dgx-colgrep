+    @staticmethod
+    def _encode_json_column(value: Any) -> Optional[str]:
+        """Serialize a structured reasoning column without double-encoding.
+
+        ``reasoning_details`` / ``codex_reasoning_items`` /
+        ``codex_message_items`` arrive as Python structures from the live
+        agent, but fork/branch/import paths hand back the raw TEXT that
+        :meth:`get_messages` returns. ``json.dumps`` on that string stores a
+        quoted JSON string, which the single ``json.loads`` on read turns into
+        a ``str`` — and every consumer gates on ``isinstance(..., list)``, so
+        the state is silently dropped. Each further round-trip added another
+        layer. Unwrap any string layers first, then encode once.
+        """
+        if not value:
+            return None
+        depth = 0
+        while isinstance(value, str) and depth < 8:
+            try:
+                value = json.loads(value)
+            except (json.JSONDecodeError, TypeError):
+                logger.warning("Ignoring non-JSON structured reasoning value on write")
+                return None
+            depth += 1
+        if not value:
+            return None
+        return json.dumps(value)
+
+    @staticmethod
+    def _decode_json_column(raw: Any, field: str) -> Any:
+        """Decode a structured reasoning column, unwrapping legacy string layers.
+
+        Rows forked before :meth:`_encode_json_column` landed may be stored
+        double- (or more) encoded; peel string layers until a structure
+        appears.
+        """
+        value = raw
+        depth = 0
+        try:
+            while isinstance(value, str) and depth < 8:
+                value = json.loads(value)
+                depth += 1
+        except (json.JSONDecodeError, TypeError):
+            logger.warning("Failed to deserialize %s, falling back to None", field)
+            return None
+        if isinstance(value, str):
+            return None
+        return value
+
